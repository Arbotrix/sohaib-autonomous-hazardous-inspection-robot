<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="inspection_robot">

  <!-- ========================= -->
  <!-- MATERIALS                 -->
  <!-- ========================= -->

  <material name="robot_gray">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>

  <material name="robot_dark">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <material name="sensor_gray">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>


  <!-- ========================= -->
  <!-- BASE BODY                 -->
  <!-- ========================= -->

  <link name="base_link">

    <visual>
      <geometry>
        <box size="0.8 0.6 0.25"/>
      </geometry>
      <origin xyz="0 0 0.32"/>
      <material name="robot_gray"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.8 0.6 0.25"/>
      </geometry>
      <origin xyz="0 0 0.445"/>
    </collision>

    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0.08"/>
      <inertia
        ixx="0.75"
        ixy="0.0"
        ixz="0.0"
        iyy="1.0"
        iyz="0.0"
        izz="1.25"/>
    </inertial>

  </link>
  <!-- Temperature Sensor -->
  <link name="temperature_link">
    <visual name="temperature_body">
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.16"/>
      </geometry>
      <material name="temperature_red">
        <color rgba="0.8 0.1 0.1 1"/>
      </material>
    </visual>

    <visual name="temperature_probe">
      <origin xyz="0 0 -0.11"/>
      <geometry>
        <cylinder radius="0.018" length="0.08"/>
      </geometry>
      <material name="metal">
        <color rgba="0.65 0.65 0.65 1"/>
      </material>
    </visual>

    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="temperature_joint" type="fixed">
    <parent link="base_link"/>
    <child link="temperature_link"/>
    <origin xyz="0.25 0 0.52" rpy="0 0 0"/>
  </joint>


  <!-- Gas Sensor -->
  <link name="gas_sensor_link">
    <visual name="gas_body">
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.14 0.12 0.09"/>
      </geometry>
      <material name="gas_yellow">
        <color rgba="0.9 0.7 0.05 1"/>
      </material>
    </visual>

    <visual name="gas_probe">
      <origin xyz="0.075 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.08"/>
      </geometry>
      <material name="metal_gas">
        <color rgba="0.55 0.55 0.55 1"/>
      </material>
    </visual>

    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="gas_sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gas_sensor_link"/>
    <origin xyz="0.0 0.25 0.47" rpy="0 0 0"/>
  </joint>


  <!-- Pressure Sensor -->
  <link name="pressure_link">
    <visual name="pressure_gauge">
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.035"/>
      </geometry>
      <material name="pressure_blue">
        <color rgba="0.1 0.3 0.9 1"/>
      </material>
    </visual>

    <visual name="pressure_connector">
      <origin xyz="0 0 -0.055"/>
      <geometry>
        <cylinder radius="0.025" length="0.08"/>
      </geometry>
      <material name="metal_pressure">
        <color rgba="0.55 0.55 0.55 1"/>
      </material>
    </visual>

    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="pressure_joint" type="fixed">
    <parent link="base_link"/>
    <child link="pressure_link"/>
    <origin xyz="-0.25 0 0.52" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- LEFT WHEEL                -->
  <!-- ========================= -->

  <link name="left_wheel_link">

    <visual>
      <geometry>
        <cylinder radius="0.16" length="0.08"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="robot_dark"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.16" length="0.08"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <inertia
        ixx="0.01"
        ixy="0.0"
        ixz="0.0"
        iyy="0.01"
        iyz="0.0"
        izz="0.01"/>
    </inertial>

  </link>

  <joint name="left_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel_link"/>

    <origin xyz="0 0.36 0.16"/>
    <axis xyz="0 1 0"/>

  </joint>


  <!-- ========================= -->
  <!-- RIGHT WHEEL               -->
  <!-- ========================= -->

  <link name="right_wheel_link">

    <visual>
      <geometry>
        <cylinder radius="0.16" length="0.08"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="robot_dark"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.16" length="0.08"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <inertia
        ixx="0.01"
        ixy="0.0"
        ixz="0.0"
        iyy="0.01"
        iyz="0.0"
        izz="0.01"/>
    </inertial>

  </link>

  <joint name="right_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel_link"/>

    <origin xyz="0 -0.36 0.16"/>
    <axis xyz="0 1 0"/>

  </joint>


  <!-- ========================= -->
  <!-- ========================= -->
  <!-- PASSIVE SUPPORT WHEELS   -->
  <!-- ========================= -->

  <link name="front_support_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="robot_dark"/>
    </visual>

 

    <inertial>
      <mass value="0.2"/>
      <inertia
        ixx="0.001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.001"
        iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="front_support_wheel_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="front_support_wheel_link"/>
    <origin xyz="0.32 0 0.08"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>


  <link name="rear_support_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="robot_dark"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.08" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia
        ixx="0.001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.001"
        iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="rear_support_wheel_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="rear_support_wheel_link"/>
    <origin xyz="-0.32 0 0.08"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>


  <!-- ========================= -->
  <!-- SENSOR MAST               -->
  <!-- ========================= -->

  <link name="sensor_mast_link">

    <visual>
      <geometry>
        <cylinder radius="0.06" length="0.45"/>
      </geometry>
      <origin xyz="0 0 0"/>
      <material name="sensor_gray"/>
    </visual>

  </link>

  <joint name="sensor_mast_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="sensor_mast_link"/>

    <origin xyz="0 0 0.65"/>

  </joint>


  <!-- ========================= -->
  <!-- LIDAR                     -->
  <!-- ========================= -->

  <link name="lidar_link">

    <visual>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
      <material name="robot_dark"/>
    </visual>

  </link>

  <joint name="lidar_joint"
         type="fixed">

    <parent link="sensor_mast_link"/>
    <child link="lidar_link"/>

    <origin xyz="0 0 0.32"/>

  </joint>


  <!-- ========================= -->
  <!-- INSPECTION SENSOR MODULE  -->
  <!-- ========================= -->

  <link name="inspection_sensor_link">

    <visual>
      <geometry>
        <box size="0.25 0.18 0.12"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>

  </link>

  <joint name="inspection_sensor_joint"
         type="fixed">

    <parent link="sensor_mast_link"/>
    <child link="inspection_sensor_link"/>

    <origin xyz="0.18 0 0.05"/>

  </joint>
  <!-- ========================= -->
  <!-- GAZEBO DIFFERENTIAL DRIVE -->
  <!-- ========================= -->

  <gazebo>

    <plugin name="diff_drive"
            filename="libgazebo_ros_diff_drive.so">

      <ros>
        <namespace>/</namespace>
      </ros>

      <update_rate>50</update_rate>

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.72</wheel_separation>
      <wheel_diameter>0.32</wheel_diameter>

      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>

    </plugin>

  </gazebo>
<!-- ========================= -->
<!-- GAZEBO LIDAR SENSOR -->
<!-- ========================= -->

<gazebo reference="lidar_link">

  <sensor name="lidar_sensor" type="ray">

    <pose>0 0 0 0 0 0</pose>

    <visualize>true</visualize>

    <update_rate>10</update_rate>

    <ray>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>

      <range>
        <min>0.12</min>
        <max>10.0</max>
        <resolution>0.01</resolution>
      </range>

    </ray>

    <plugin name="gazebo_ros_lidar"
            filename="libgazebo_ros_ray_sensor.so">

      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=scan</remapping>
      </ros>

      <output_type>sensor_msgs/LaserScan</output_type>
      <frame_name>lidar_link</frame_name>

    </plugin>

  </sensor>

</gazebo>
  <!-- Gazebo sensor colors -->
  <gazebo reference="temperature_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="gas_sensor_link">
    <material>Gazebo/Yellow</material>
  </gazebo>

  <gazebo reference="pressure_link">
    <material>Gazebo/Blue</material>
  </gazebo>
</robot>
