<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="hazardous_facility">

    <!-- ========================= -->
    <!-- LIGHTING & GROUND         -->
    <!-- ========================= -->

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ========================= -->
    <!-- FACILITY WALLS            -->
    <!-- 16m x 12m                 -->
    <!-- ========================= -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 6 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16 0.2 2</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -6 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16 0.2 2</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient></material>
